#
# OpenShell BYOC image for AI-Q (async API + Dask via deploy/entrypoint.py).
#
# OpenShell requires a non-distroless image with iproute2; the default AI-Q
# backend image uses distroless, so this file produces a separate runtime.
#
# The gateway bind-mounts the `openshell-sandbox` supervisor from the host build
# (glibc on modern distros, e.g. Fedora 43). Ubuntu 22.04 (Jammy) is too old
# (glibc 2.35). Use Ubuntu 24.04 (Noble, glibc 2.39) so the supervisor can run.
#
# Build from the repository root (required so COPY paths match):
#   docker build -f Dockerfile.openshell --target openshell -t aiq-openshell:local .
#
# Install steps are kept aligned with deploy/Dockerfile (builder + dev-builder).

FROM ubuntu:24.04 AS builder

WORKDIR /app

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y \
    tzdata \
    build-essential \
    curl \
    git \
    python3.12 \
    python3.12-dev \
    python3.12-venv \
    && rm -rf /var/lib/apt/lists/*

# ensurepip is disabled for system Python on Ubuntu 24.04 — install uv standalone.
RUN curl -LsSf https://astral.sh/uv/install.sh \
        | env UV_INSTALL_DIR=/usr/local/bin sh \
    && chmod +x /usr/local/bin/uv \
    && ln -sf /usr/bin/python3.12 /usr/local/bin/python \
    && ln -sf /usr/bin/python3.12 /usr/local/bin/python3

RUN uv venv /app/.venv --python /usr/local/bin/python

ENV VIRTUAL_ENV=/app/.venv
ENV PATH="/app/.venv/bin:$PATH"
ENV UV_PYTHON=/app/.venv/bin/python
# PyPI can be slow behind strict egress; longer timeout reduces flaky `uv sync` failures.
ENV UV_HTTP_TIMEOUT=300

COPY pyproject.toml uv.lock ./

COPY src/ ./src/
COPY sources/ ./sources/
COPY frontends/aiq_api/ ./frontends/aiq_api/
COPY frontends/cli/ ./frontends/cli/
COPY frontends/debug/ ./frontends/debug/
COPY configs/ ./configs/
COPY deploy/entrypoint.py deploy/start_web.py ./deploy/
COPY deploy/openshell/scripts ./deploy/openshell/scripts/

RUN uv sync --frozen --no-dev --no-install-workspace

RUN uv pip install --no-deps -e . \
    && uv pip install --no-deps -e ./sources/google_scholar_paper_search \
    && uv pip install --no-deps -e ./sources/tavily_web_search \
    && uv pip install --no-deps -e "./sources/knowledge_layer[all]" \
    && uv pip install --no-deps -e ./frontends/aiq_api \
    && uv pip install "psycopg[binary]>=3.0.0"

# aiq_api declares dask, but --no-deps skips it; entrypoint.py needs dask-scheduler / dask-worker on PATH.
RUN uv pip install "dask[distributed]>=2024.1.0"

RUN /app/.venv/bin/python -c "import aiq_api; import knowledge_layer; import distributed; print('✓ Base packages installed')" \
    && test -x /app/.venv/bin/dask-scheduler && test -x /app/.venv/bin/dask-worker

RUN chmod +x /app/deploy/start_web.py \
    && mkdir -p /app/data \
    && chown -R 1000:1000 /app

FROM builder AS dev-builder

RUN uv pip install --no-deps -e ./frontends/cli \
    && uv pip install --no-deps -e ./frontends/debug

RUN /app/.venv/bin/python -c "import aiq_api; import aiq_research_cli; import aiq_debug; import knowledge_layer; print('✓ All packages installed')"

# -----------------------------------------------------------------------------
# OpenShell runtime: glibc-based Ubuntu, OpenShell BYOC packages, high-UID user
# -----------------------------------------------------------------------------
FROM ubuntu:24.04 AS openshell

WORKDIR /app

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y \
    ca-certificates \
    curl \
    iproute2 \
    iptables \
    python3.12 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=dev-builder /app /app

# The venv was created in the builder with python at /usr/local/bin/python;
# restore the same path in this stage (Noble ships python3.12 as /usr/bin/python3.12).
RUN ln -sf /usr/bin/python3.12 /usr/local/bin/python \
    && ln -sf /usr/bin/python3.12 /usr/local/bin/python3

RUN groupadd -g 1000660000 sandbox \
    && useradd -m -u 1000660000 -g sandbox sandbox \
    && mkdir -p /sandbox/data /app/data \
    && chown -R sandbox:sandbox /app /sandbox

USER sandbox

ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV HOST=0.0.0.0
ENV PORT=8000
ENV CONFIG_FILE=/app/configs/config_web_default_llamaindex.yml
# Writable state (Landlock / OpenShell policy: keep DBs under /sandbox/data)
ENV NAT_JOB_STORE_DB_URL=sqlite+aiosqlite:////sandbox/data/jobs.db
ENV AIQ_CHROMA_DIR=/sandbox/data/chroma_data
ENV AIQ_CHECKPOINT_DB=/sandbox/data/checkpoints.db
ENV AIQ_SUMMARY_DB=sqlite+aiosqlite:////sandbox/data/summaries.db

EXPOSE 8000

# OpenShell replaces image ENTRYPOINT; pass explicitly, e.g.:
#   openshell sandbox create --from Dockerfile.openshell --forward 8000 -- python /app/deploy/entrypoint.py
